# Maintainer: bhimio1
pkgname=material-3-music-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Material 3 YouTube Music client and local music player"
arch=('x86_64' 'aarch64')
url="https://github.com/bhimio1/material-3-music"
license=('unknown')  # TODO: pick a license
depends=('libxkbcommon' 'wayland' 'libglvnd' 'mpv' 'yt-dlp' 'xdg-utils')
makedepends=('cargo' 'git')
optdepends=('ffmpeg: converting and tagging downloads (yt-dlp)')
provides=('material-3-music')
conflicts=('material-3-music')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/m3-music "$pkgdir/usr/bin/m3-music"
  install -Dm644 packaging/material_3_music.desktop "$pkgdir/usr/share/applications/material_3_music.desktop"
  install -Dm644 assets/fonts/LICENSE-Inter.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Inter.txt"
}
